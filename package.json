{
  "name": "kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks how a TypeScript app's code is structured and proved against its spec.",
  "scripts": {
    "check": "node scripts/kit-check.mjs",
    "refs": "node scripts/kit-refs.mjs",
    "consumers": "node scripts/kit-consumers.mjs",
    "runs": "node scripts/kit-runs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-node": "^1.6.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.1",
    "vitest": "^1.4.0"
  }
}
